{
  "name": "dsh-conversation-manager",
  "version": "0.1.0",
  "description": "自研 DeepSeek Harness 会话管理插件：删除对话（回收站可恢复/彻底清除）+ 已归档会话管理 + 批量删除。",
  "author": "TrisChick",
  "repository": {
    "type": "git",
    "url": "https://github.com/TrisChick/dsh-conversation-manager"
  },
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT"
}
