{
  "name": "dsh-conversation-manager",
  "version": "0.2.0",
  "description": "自研 DeepSeek Harness 会话管理插件：删除对话（回收站可恢复/彻底清除）+ 已归档会话管理 + 批量删除。",
  "author": "TrisChick",
  "repository": {
    "type": "git",
    "url": "https://github.com/TrisChick/dsh-conversation-manager"
  },
  "private": true,
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT"
}
